    "predict": {
      "blueprint_name": "predict_bp",
      "url_prefix": "/predict", 
      "description": "Prediction API - Mesh generation prediction using trained reinforcement learning models",
      "endpoints": [
        {
          "path": "/predict/components",
          "methods": ["GET"],
          "description": "Get available predictors, reference selectors, models, and meshes",
          "parameters": {},
          "responses": {
            "200": "Components list returned",
            "500": "Server error"
          }
        },
        {
          "path": "/predict/session/create",
          "methods": ["POST"],
          "description": "Create a new prediction session",
          "parameters": {
            "body": {
              "mesh_name": {
                "type": "string",
                "required": true,
                "description": "Initial mesh file name"
              },
              "predictor_type": {
                "type": "string",
                "required": true,
                "description": "Predictor type (RL)"
              },
              "predictor_config": {
                "type": "object",
                "required": true,
                "properties": {
                  "model_path": {
                    "type": "string",
                    "required": true,
                    "description": "Path to trained SAC model"
                  },
                  "n": {
                    "type": "integer",
                    "default": 2,
                    "description": "Number of neighbor vertices"
                  },
                  "g": {
                    "type": "integer",
                    "default": 3,
                    "description": "Number of observation points"
                  },
                  "beta": {
                    "type": "integer",
                    "default": 6,
                    "description": "State observation radius factor"
                  }
                }
              },
              "ref_selector_type": {
                "type": "string", 
                "default": "default",
                "description": "Reference point selector type"
              },
              "ref_selector_config": {
                "type": "object",
                "default": {},
                "description": "Reference selector configuration"
              }
            }
          },
          "responses": {
            "200": "Session created successfully",
            "400": "Missing required fields or invalid parameters", 
            "500": "Server error"
          }
        },
        {
          "path": "/predict/session/<session_id>/status",
          "methods": ["GET"],
          "description": "Get current status of prediction session",
          "parameters": {
            "path": {
              "session_id": {
                "type": "string",
                "required": true,
                "description": "Session identifier"
              }
            }
          },
          "responses": {
            "200": "Status returned",
            "404": "Session not found",
            "500": "Server error"
          }
        },
        {
          "path": "/predict/session/<session_id>/config",
          "methods": ["PUT"],
          "description": "Update session configuration (predictor or reference selector)",
          "parameters": {
            "path": {
              "session_id": {
                "type": "string",
                "required": true,
                "description": "Session identifier"
              }
            },
            "body": {
              "predictor_type": {
                "type": "string",
                "description": "New predictor type"
              },
              "predictor_config": {
                "type": "object",
                "description": "New predictor configuration"
              },
              "ref_selector_type": {
                "type": "string",
                "description": "New reference selector type"
              },
              "ref_selector_config": {
                "type": "object",
                "description": "New reference selector configuration"
              }
            }
          },
          "responses": {
            "200": "Configuration updated",
            "400": "Bad Request",
            "404": "Session not found",
            "500": "Server error"
          }
        },
        {
          "path": "/predict/session/<session_id>/next",
          "methods": ["POST"],
          "description": "Execute next prediction step",
          "parameters": {
            "path": {
              "session_id": {
                "type": "string",
                "required": true,
                "description": "Session identifier"
              }
            }
          },
          "responses": {
            "200": "Step executed",
            "404": "Session not found", 
            "500": "Server error"
          }
        },
        {
          "path": "/predict/session/<session_id>/prev",
          "methods": ["POST"],
          "description": "Undo previous step (go back to previous state)",
          "parameters": {
            "path": {
              "session_id": {
                "type": "string",
                "required": true,
                "description": "Session identifier"
              }
            }
          },
          "responses": {
            "200": "Step undone",
