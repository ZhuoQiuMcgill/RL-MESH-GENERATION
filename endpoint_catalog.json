  "blueprints": {
    "training": {
      "blueprint_name": "training_bp",
      "url_prefix": "/training",
      "description": "Training Management API - Comprehensive control over reinforcement learning training sessions",
      "endpoints": [
        {
          "path": "/training/start",
          "methods": ["POST"],
          "description": "Start a new training session with specified parameters",
          "parameters": {
            "body": {
              "mesh_name": {
                "type": "string",
                "required": false,
                "description": "Name of mesh file to use (without .txt)"
              },
              "subfolder": {
                "type": "string",
                "default": "mesh",
                "description": "Subfolder containing mesh file"
              },
              "max_timesteps": {
                "type": "integer",
                "description": "Maximum training timesteps"
              },
              "max_steps": {
                "type": "integer", 
                "description": "Maximum steps per episode"
              },
              "description": {
                "type": "string",
                "description": "Training session description"
              },
              "checkpoint_name": {
                "type": "string",
                "description": "Checkpoint name if resuming"
              },
              "from_checkpoint": {
                "type": "boolean",
                "default": false,
                "description": "Whether to resume from checkpoint"
              }
            }
          },
          "responses": {
            "200": "Training started successfully",
            "400": "Runtime/Value Error (e.g., training already running)",
            "500": "Internal server error"
          }
        },
        {
          "path": "/training/stop",
          "methods": ["POST"],
          "description": "Stop the currently running training session",
          "parameters": {},
          "responses": {
            "200": "Training stopped successfully", 
            "500": "Internal server error"
          }
        },
        {
          "path": "/training/status",
          "methods": ["GET"],
          "description": "Get current training status with real-time statistics",
          "parameters": {},
          "responses": {
            "200": "Status retrieved (always returns 200 for availability)"
          }
        },
        {
          "path": "/training/health",
          "methods": ["GET"],
          "description": "Training service health check",
          "parameters": {},
          "responses": {
            "200": "Service is healthy",
            "500": "Service is unhealthy"
          }
        }
      ]
    },
