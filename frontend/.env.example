# Environment Configuration
# Copy this file to .env and customize the values

# API Base URL - Change this for different environments
# Development: http://localhost:8000
# Production: https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8000

# Example environment-specific configurations:
# VITE_API_BASE_URL=http://localhost:5000  # Flask development server
# VITE_API_BASE_URL=http://127.0.0.1:8000  # Alternative localhost
# VITE_API_BASE_URL=https://api.example.com  # Production server
